# Supabase
NEXT_PUBLIC_SUPABASE_URL=your-supabase-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# LINE LIFF (one LIFF app per route in LINE Developers Console)
# Required for production — leave blank in DEMO_MODE.
NEXT_PUBLIC_LIFF_ID_CHECKIN=your-liff-id-checkin
NEXT_PUBLIC_LIFF_ID_ATTENDANCE=your-liff-id-attendance
NEXT_PUBLIC_LIFF_ID_LEAVE=your-liff-id-leave
NEXT_PUBLIC_LIFF_ID_OT=your-liff-id-ot
NEXT_PUBLIC_LIFF_ID_PAYSLIP=your-liff-id-payslip
NEXT_PUBLIC_LIFF_ID_AI_CHAT=your-liff-id-ai-chat
NEXT_PUBLIC_LIFF_ID_TEAM=your-liff-id-team
NEXT_PUBLIC_LIFF_ID_ONBOARD=your-liff-id-onboard
NEXT_PUBLIC_LIFF_ID_REGISTER=your-liff-id-register
# Optional dedicated analytics LIFF app. If unset, /liff/analytics reuses the
# Attendance LIFF ID; that reuse requires its Endpoint URL to cover /liff/*.
NEXT_PUBLIC_LIFF_ID_ANALYTICS=your-liff-id-analytics
# v3 additions — create new LIFF apps in LINE Developers Console for these
# routes if you want Rich Menu / external links to open them directly.
# If unset, the SaaS register-supervisor form falls back to LIFF_ID_REGISTER
# and /liff/profile falls back to LIFF_ID_CHECKIN (works for bottom-nav use).
NEXT_PUBLIC_LIFF_ID_REGISTER_SUPERVISOR=your-liff-id-register-supervisor
NEXT_PUBLIC_LIFF_ID_PROFILE=your-liff-id-profile

# Verified LIFF server session. LINE_LOGIN_CHANNEL_ID is the channel that owns
# the LIFF apps, not the Messaging API channel below. Keep the signing secret
# server-only and use at least 32 random characters. LIFF apps need openid scope.
LINE_LOGIN_CHANNEL_ID=your-line-login-channel-id
LIFF_SESSION_SECRET=replace-with-at-least-32-random-characters

# LINE Messaging API
LINE_CHANNEL_ACCESS_TOKEN=your-channel-access-token
LINE_CHANNEL_SECRET=your-channel-secret
LINE_CHANNEL_ID=your-channel-id

# Mastra / Anthropic
ANTHROPIC_API_KEY=your-anthropic-api-key

# OpenAI Workforce Assistant (web dashboard). The synthetic JSON demo is
# retained for multi-turn responses. Live tenant responses and local audit
# persistence remain off unless explicitly enabled after a PDPA/DPA review.
OPENAI_API_KEY=your-openai-api-key
OPENAI_STORE_RESPONSES=false
WORKFORCE_ASSISTANT_AUDIT_ENABLED=false
WORKFORCE_ASSISTANT_MAX_OUTPUT_TOKENS=5000

# Local cost controls plus an optional shared Supabase quota for Vercel.
WORKFORCE_ASSISTANT_RATE_LIMIT_WINDOW_SECONDS=60
WORKFORCE_ASSISTANT_RATE_LIMIT_REQUESTS=12
WORKFORCE_ASSISTANT_RATE_LIMIT_ORG_REQUESTS=60
WORKFORCE_ASSISTANT_DAILY_ORG_REQUESTS=300
WORKFORCE_ASSISTANT_MAX_CONCURRENT_REQUESTS=2
WORKFORCE_ASSISTANT_ORG_MAX_CONCURRENT_REQUESTS=6
WORKFORCE_ASSISTANT_CONCURRENCY_RETRY_AFTER_SECONDS=3
WORKFORCE_ASSISTANT_SHARED_RATE_LIMIT=false
WORKFORCE_ASSISTANT_SHARED_RATE_LIMIT_REQUIRED=false

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
DEMO_MODE=true

# Optional server-only role bindings for real LINE accounts in the in-memory
# sales demo. Values may be seeded employee codes or UUIDs. Map an HR/owner
# account (EMP004 or EMP008) to open organization analytics; EMP002/EMP006 see
# only their assigned team. Never expose this variable as NEXT_PUBLIC_*.
DEMO_LIFF_EMPLOYEE_MAP={"U00000000000000000000000000000000":"EMP008"}

# Organization-owner web login. These values are server-only. Production fails
# closed if they are missing or partial; an all-blank set is bypassed only in
# local development. DASHBOARD_ORG_ID binds the owner session to one tenant.
DASHBOARD_AUTH_USERNAME=
DASHBOARD_AUTH_PASSWORD=
DASHBOARD_SESSION_SECRET=
DASHBOARD_ORG_ID=

# Optional legacy read-only analytics sales demo. Prefer the signed owner login.
DASHBOARD_ANALYTICS_DEMO=false

# Deterministic workforce JSON source for the analytics dashboard, Excel export,
# and workforce assistant. This required target must exactly match the
# organization resolved by dashboard or LIFF access; missing values never act as
# a wildcard.
DASHBOARD_WORKFORCE_JSON_DEMO=false
DEMO_WORKFORCE_ORG_ID=
